# Comma-separated frontend origins allowed to call this API.
# Do not include a trailing slash.
# Example: https://background-remover.vercel.app,http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Accurate default. Use u2netp only when lower CPU usage matters more than quality.
REMBG_MODEL=bria-rmbg
