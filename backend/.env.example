# Comma-separated frontend origins allowed to call this API.
# Do not include a trailing slash.
FRONTEND_ORIGINS=https://freebgr.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Lightweight defaults suitable for a 512 MiB Render instance.
REMBG_MODEL=u2netp
MAX_PROCESSING_DIMENSION=1280
ENABLE_DECONTAMINATE=false
